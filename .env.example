# ── Browser (public by design; protected by Row Level Security) ──────────────
# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ── Server only (never prefixed with VITE_, never sent to the browser) ───────
# Used by `npm run db:push` to apply supabase/migrations. Supabase → Connect →
# "Session pooler" connection string, with your database password filled in.
SUPABASE_DB_URL=

# Email delivery through Resend (optional). Without these, PayFlow says email
# isn't configured and offers "copy link" / "mark as sent" instead.
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "PayFlow <invoices@yourdomain.com>"
EMAIL_FROM=
# Public URL used for "View invoice" links in emails (defaults to the request origin)
APP_URL=
